# GraphQL endpoint exposing the swp_* schema over the Publisher Postgres.
NEXT_PUBLIC_API_URL=https://graphql-staging.pesacheck.org/v1/graphql
# Tenant to filter every query by (staging PesaCheck tenant).
NEXT_PUBLIC_TENANT_CODE=123abc

# Base URL for media bytes; image URLs are built as ${MEDIA_URL}${asset_id}.webp
NEXT_PUBLIC_MEDIA_URL=https://media-staging.pesacheck.org/media/

# Shared secret sent as the `x-preshared-auth` header on every server-side
# GraphQL request. Cloudflare's Bot Fight Mode challenges Vercel's Node runtime
# (AWS IPs) and silently breaks fetching; a WAF rule on graphql-staging.pesacheck.org
# skips bot protection when this header matches. Server-only — do NOT prefix with
# NEXT_PUBLIC_ (it must not reach the browser). Set the same value here and in the
# Cloudflare WAF rule. Leave unset for local dev (no challenge applies).
EDGE_PRESHARED_AUTH=

# Contact form (app/api/contact) — Airtable base that stores "Send us a message"
# submissions as a trackable request log. Create a Personal Access Token
# (airtable.com/create/tokens) with data.records:write on the base. The table
# needs Name, Email, Subject, Message (text) and Status (single-select) columns.
# Without the token + base id the form returns a 500.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Contact Us

# reCAPTCHA v3 keys protecting the contact form. When both are absent the form
# still submits (captcha is skipped); when set, submissions scoring < 0.7 are
# rejected server-side. Site key is public (loaded in the browser).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: score (0.0–1.0) below which a submission is rejected as a bot.
# Defaults to 0.7 when unset.
RECAPTCHA_SCORE_THRESHOLD=0.7

# Google Form linked from the Contact Us "want us to fact-check" CTA. Falls
# back to the current production form when unset.
NEXT_PUBLIC_FACT_CHECK_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeI9xshwBWxwDuLwT4jhR9hdRLUNkwdjo0sqEqV9N5r5lCQYQ/viewform?usp=sf_link&ref=pesacheck.org

# Fact-check filter options (lib/data/filter-options.ts). Server-only.
# How many recent fact-checks are read to build the Region/Language/Topic
# dropdowns (default 300), and how long the derived set is cached (default 3600s).
FILTER_OPTIONS_SAMPLE_SIZE=300
FILTER_OPTIONS_TTL_SECONDS=3600
