# GraphQL endpoint exposing the swp_* schema over the Publisher Postgres.
NEXT_PUBLIC_API_URL=https://pesacheckstaging-hasura.superdesk.org/v1/graphql

# Tenant to filter every query by (staging PesaCheck tenant).
NEXT_PUBLIC_TENANT_CODE=e6lkum

# Base URL for media bytes; image URLs are built as ${MEDIA_URL}${asset_id}.webp
NEXT_PUBLIC_MEDIA_URL=https://pesacheck-staging-publisher.superdesk.pro/media/

# Contact form (app/api/contact) — Airtable base that stores "Send us a message"
# submissions as a trackable request log. Create a Personal Access Token
# (airtable.com/create/tokens) with data.records:write on the base. The table
# needs Name, Email, Subject, Message (text) and Status (single-select) columns.
# Without the token + base id the form returns a 500.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Contact Us

# reCAPTCHA v3 keys protecting the contact form. When both are absent the form
# still submits (captcha is skipped); when set, submissions scoring < 0.7 are
# rejected server-side. Site key is public (loaded in the browser).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: score (0.0–1.0) below which a submission is rejected as a bot.
# Defaults to 0.7 when unset.
RECAPTCHA_SCORE_THRESHOLD=0.7
